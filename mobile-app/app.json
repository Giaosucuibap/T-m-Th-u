{
  "expo": {
    "name": "Giáo Sư Cùi Bắp",
    "slug": "giao-su-cui-bap",
    "version": "1.0.0",
    "scheme": "gscb",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f5f8",
    "primaryColor": "#0f766e",
    "description": "Tìm gói thầu trên Hệ thống mạng đấu thầu quốc gia (e-GP), chấm điểm phù hợp và nhắc hạn nộp hồ sơ.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.giaosucuibap.mobile",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.giaosucuibap.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0f766e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a2f2b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
