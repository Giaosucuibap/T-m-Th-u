{
  "manifest_version": 3,
  "name": "Giáo Sư Cùi Bắp",
  "short_name": "Giáo Sư Cùi Bắp",
  "version": "3.9.2",
  "description": "Năm chức năng trên Hệ thống mạng đấu thầu quốc gia: tìm thông báo mời thầu; tra nhà thầu trúng thầu theo mã số thuế; soi biên bản mở thầu kèm tỷ lệ giảm giá; tra kế hoạch lựa chọn nhà thầu theo chủ đầu tư/xã phường; và soi địa bàn để xem xã/phường nào hay có công ty nào trúng thầu.",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://muasamcong.mpi.gov.vn/*",
    "https://api.telegram.org/*",
    "http://localhost:1234/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Giáo Sư Cùi Bắp",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://muasamcong.mpi.gov.vn/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://muasamcong.mpi.gov.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
