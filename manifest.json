{
  "manifest_version": 3,
  "name": "Giáo Sư Cùi Bắp",
  "short_name": "Giáo Sư Cùi Bắp",
  "version": "4.0.3",
  "minimum_chrome_version": "111",
  "description": "Trợ lý ra quyết định dự thầu trên e-GP: tìm và chấm điểm gói thầu, Radar thay đổi, pipeline Go/No-Go, hồ sơ nhà thầu/chủ đầu tư, đối thủ, địa bàn và báo cáo Excel.",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://muasamcong.mpi.gov.vn/*",
    "https://api.telegram.org/*",
    "http://localhost:1234/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Giáo Sư Cùi Bắp",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://muasamcong.mpi.gov.vn/*/web/guest/contractor-selection*",
        "https://muasamcong.mpi.gov.vn/web/guest/contractor-selection*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://muasamcong.mpi.gov.vn/*/web/guest/contractor-selection*",
        "https://muasamcong.mpi.gov.vn/web/guest/contractor-selection*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
